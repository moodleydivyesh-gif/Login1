
package com.mycompany.login1;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeEach;
import static org.junit.jupiter.api.Assertions.*;
import java.util.Arrays;     // PART 3: Arrays.toString(), used with assertArrayEquals
import java.util.ArrayList;

public class TestPart3 {

    private Messages msg1, msg2, msg3, msg4, msg5;

    
// @BeforeEach — resets all arrays then populates test data
// using Messages.resetAll();

    @BeforeEach
    public void setUp() {
        Messages.resetAll(); // clear all static arrays

        // Create 5 test messages using exact assignment test data
        msg1 = new Messages("+27834557896",
                            "Did you get the cake?", 1);
        msg2 = new Messages("+27838884567",
                            "Where are you? You are late! I have asked you to be on time.", 2);
        msg3 = new Messages("+27834484567",
                            "Yohoooo, I am at your gate.", 3);
        msg4 = new Messages("0838884567",
                            "It is dinner time!", 4);
        msg5 = new Messages("+27838884567",
                            "Ok, I am leaving without you.", 5);

        // Populate the correct arrays by calling SentMessage()
        msg1.SentMessage(1); // → sentList
        msg2.SentMessage(3); // → storedList
        msg3.SentMessage(2); // → disregardedList
        msg4.SentMessage(1); // → sentList
        msg5.SentMessage(3); // → storedList
    }

    
    // TEST 1: Sent Messages array correctly populate
    // REQUIREMENT: Returns "Did you get the cake?", "It is dinner time!"
    //  USED:java.util.Arrays
    
    @Test
    public void testSentMessagesArrayPopulated() {

        // Expected: a String[] with exactly these 2 values in order
        String[] expected = {
            "Did you get the cake?",
            "It is dinner time!"
        };

        // Actual: MessageManager returns the sent messages as String[]
        String[] actual = MessageManager.getSentMessagesAsArray();

        // ARRAYS: Arrays.toString() prints both arrays for comparison in output
        System.out.println("Expected : " + Arrays.toString(expected));
        System.out.println("Actual   : " + Arrays.toString(actual));

        // ARRAYS: assertArrayEquals compares two String[] element by element
        // Fails if size differs OR if any element doesn't match exactly
        assertArrayEquals(expected, actual,
            "Sent messages array should contain exactly msg1 and msg4.");
    }

 
    // TEST 2: Display the longest message
    // REQUIREMENT: Returns Message 2 — the longest of all 5
    //  Using STRING manipulation : assertEquals checks the exact returned String
  
    @Test
    public void testGetLongestMessage() {
        String longest = MessageManager.getLongestMessage();

        assertEquals(
            "Where are you? You are late! I have asked you to be on time.",
            longest,
            "Message 2 is the longest message."
        );

        System.out.println("Longest: " + longest);
    }

    
    // TEST 3: Search for message by ID
    // REQUIREMENT: Search "0838884567" returns "It is dinner time!
    // STRING: .contains() checks the result String includes expected text
   
    public void testSearchByID() {
        String result = MessageManager.searchByID("0838884567");

        assertTrue(result.contains("It is dinner time!"),
            "Searching '0838884567' should return 'It is dinner time!'");

        System.out.println("Search result:\n" + result);
    }

    // TEST 4: Search all messages for a particular recipient
   // REQUIREMENT: +27838884567 returns both Message 2 and Message 5
  // STRING: .contains() used twice to check both messages present

    @Test
    public void testSearchByRecipient() {
        String result = MessageManager.searchByRecipient("+27838884567");

        assertTrue(
            result.contains("Where are you? You are late! I have asked you to be on time."),
            "Should find Message 2 for recipient +27838884567"
        );
        assertTrue(
            result.contains("Ok, I am leaving without you."),
            "Should find Message 5 for recipient +27838884567"
        );

        System.out.println("Recipient search:\n" + result);
    }

    
    // TEST 5: Delete a message using the message hash
    // REQUIREMENT: Delete Message 2 — system confirms deletion.
    
    @Test
    public void testDeleteByHash() {
        String hashToDelete = msg2.getMessageHash();

        assertEquals(2, Messages.getStoredList().size(),
            "storedList should have 2 messages before deletion.");

        String result = MessageManager.deleteByHash(hashToDelete);

        assertTrue(result.contains("Where are you? You are late! I have asked you to be on time."),
            "Result should name the deleted message.");
        assertTrue(result.contains("successfully deleted."),
            "Result should confirm deletion.");

        // After deletion, stored list should have 1 message remaining
        assertEquals(1, Messages.getStoredList().size(),
            "storedList should have 1 message after deletion.");

        System.out.println("Delete result: " + result);
    }

   
    // TEST 6: Display full report
    // REQUIREMENT: Report shows Hash, Recipient, Message for all.
    
    @Test
    public void testDisplayReport() {
        String report = MessageManager.displayReport();

        assertNotNull(report);
        assertTrue(report.contains("Message Hash"));
        assertTrue(report.contains("Recipient"));
        assertTrue(report.contains("Did you get the cake?"));
        assertTrue(report.contains("It is dinner time!"));

        System.out.println(report);
    }

   
    // TEST 7: hashArray and idArray populated correctly
    // java.util.Arrays USED:
    //   Arrays.toString() — prints the String[] in test output
    //   getHashArray() returns the filled String[] from Messages
   
    @Test
    public void testHashAndIDArraysPopulated() {
        String[] hashes = Messages.getHashArray();
        String[] ids    = Messages.getIdArray();

        // Both arrays should have exactly 5 entries (one per message)
        assertEquals(5, hashes.length,
            "hashArray should have 5 entries — one per message.");
        assertEquals(5, ids.length,
            "idArray should have 5 entries — one per message.");

        // ARRAYS: Arrays.toString() prints array content in test output
        System.out.println("All Hashes: " + Arrays.toString(hashes));
        System.out.println("All IDs   : " + Arrays.toString(ids));

        // Every hash should be uppercase (not null)
        for (int i = 0; i < hashes.length; i++) {
            assertNotNull(hashes[i], "Hash at index " + i + " should not be null.");
            // STRING: .toUpperCase() on already-uppercase → same value
            assertEquals(hashes[i].toUpperCase(), hashes[i],
                "Hash at index " + i + " should be all uppercase.");
        }
    }

   
    // TEST 8: Disregarded array correctly populated
    
    @Test
    public void testDisregardedArrayPopulated() {
        ArrayList<Messages> dis = Messages.getDisregardedList();
        assertEquals(1, dis.size());
        assertEquals("Yohoooo, I am at your gate.", dis.get(0).getMessageText());
    }

    
    // TEST 9: Stored array correctly populated
    
    @Test
    public void testStoredArrayPopulated() {
        assertEquals(2, Messages.getStoredList().size(),
            "storedList should have exactly 2 messages.");
    }
}
